<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings, used with: dotnet test -settings coverage.runsettings -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Only measure the solution code, not the test project -->
          <Include>[CodeTest]*</Include>
          <!-- Program.cs only passes the real console streams to ConsoleApp.Run, which is tested directly -->
          <ExcludeByFile>**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
